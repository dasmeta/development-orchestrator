{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-orchestrator.invalid/schemas/feature-release-record.schema.json",
  "title": "Archived feature release evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "decision", "status", "policy_version", "subjects", "evidence", "waivers", "archived_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "feature_id": {"type": "string", "minLength": 1},
    "decision": {"const": "release-ready"},
    "status": {"const": "ready"},
    "policy_version": {"type": "string", "minLength": 1},
    "subjects": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "waivers": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "object"}},
    "archived_at": {"type": "string", "format": "date-time"}
  }
}
