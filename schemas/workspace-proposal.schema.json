{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/workspace-proposal.schema.json",
  "title": "Workspace Bootstrap Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "status",
    "inventory_fingerprint",
    "workspace",
    "repositories",
    "stages",
    "routing_notes",
    "unresolved_questions",
    "allow_update",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["draft", "needs-input", "ready", "approved"]
    },
    "inventory_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspace": {
      "type": "object",
      "required": ["name", "description", "root"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    },
    "stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/stage"}
    },
    "routing_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "allow_update": {"type": "boolean"},
    "approval": {
      "type": "object",
      "required": ["confirmed", "confirmed_at"],
      "properties": {
        "confirmed": {"type": "boolean"},
        "confirmed_at": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "description",
        "authority",
        "scope",
        "dependencies",
        "source_path",
        "target_path",
        "materialization",
        "required",
        "dirty",
        "allow_dirty",
        "remotes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "authority": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "source_path": {"type": "string"},
        "target_path": {
          "type": "string",
          "pattern": "^(00|01|02|03|04|05)-[^/]+(/[^/]+)*$"
        },
        "materialization": {
          "enum": ["move", "symlink", "clone", "keep"]
        },
        "required": {"type": "boolean"},
        "dirty": {"type": "boolean"},
        "allow_dirty": {"type": "boolean"},
        "remotes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["id", "repository", "skill"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "skill": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
