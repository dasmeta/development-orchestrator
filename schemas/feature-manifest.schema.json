{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "feature_id",
    "stage",
    "repositories",
    "mergeability"
  ],
  "properties": {
    "feature_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mergeability": {
      "type": "object",
      "required": [
        "ready",
        "reason"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": ["object", "null"],
      "properties": {
        "schema_version": {"const": "1"},
        "mode": {"enum": ["off", "observe", "enforce"]},
        "scope": {"type": "string"},
        "claims": {"type": "string"},
        "architecture": {"type": "string"},
        "gate_plan": {"type": "string"},
        "readiness": {"type": "string"},
        "current_decision": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
