{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "feature_id",
    "stage",
    "repositories",
    "mergeability"
  ],
  "properties": {
    "feature_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mergeability": {
      "type": "object",
      "required": [
        "ready",
        "reason"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
