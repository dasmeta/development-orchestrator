{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-orchestrator.invalid/schemas/feature-evidence.schema.json",
  "title": "Normalized feature evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "feature_id", "evidence_type",
    "provider_id", "producer", "coverage", "subject", "policy_version",
    "provider_config_digest", "result", "outcome", "environment",
    "collected_at", "expires_at", "artifacts", "findings", "known_gaps"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "evidence_id": {"$ref": "#/$defs/id"},
    "feature_id": {"$ref": "#/$defs/id"},
    "evidence_type": {"$ref": "#/$defs/id"},
    "provider_id": {"$ref": "#/$defs/id"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "run_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_ids", "architecture_constraint_ids"],
      "properties": {
        "claim_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "architecture_constraint_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "repositories": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "string", "pattern": "^(commit|worktree):[^\\r\\n]+$"}
        }
      }
    },
    "policy_version": {"type": "string", "minLength": 1},
    "provider_config_digest": {"type": "string", "minLength": 1},
    "result": {"enum": ["passed", "failed", "blocked"]},
    "outcome": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fixture"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "fixture": {"type": ["string", "null"]}
      }
    },
    "collected_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "object"}},
    "supersedes_evidence_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "digest": {"type": ["string", "null"]},
        "media_type": {"type": ["string", "null"]}
      }
    }
  }
}
