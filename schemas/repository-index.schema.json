{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/repository-index.schema.json",
  "title": "Portable Workspace Repository Index",
  "type": "object",
  "required": ["schema_version", "workspace", "repositories", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "description",
          "authority",
          "scope",
          "dependencies",
          "target_path",
          "required",
          "remotes"
        ],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "role": {"type": "string"},
          "description": {"type": "string"},
          "authority": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "target_path": {"type": "string"},
          "required": {"type": "boolean"},
          "remotes": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository", "skill"],
        "properties": {
          "id": {"type": "string"},
          "repository": {"type": "string"},
          "skill": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
