{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-orchestrator.invalid/schemas/feature-architecture.schema.json",
  "title": "Feature architecture constraints",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "sources", "constraints"],
  "properties": {
    "schema_version": {"const": "1"},
    "feature_id": {"$ref": "#/$defs/id"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "content_digest"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "repository_id": {"$ref": "#/$defs/id"},
          "revision": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "content_digest": {"type": "string", "minLength": 1},
          "approval_evidence_id": {"type": ["string", "null"]}
        },
        "anyOf": [{"required": ["repository_id", "path"]}, {"required": ["reference"]}]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "content_digest", "enforcement"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "source_id": {"$ref": "#/$defs/id"},
          "section": {"type": ["string", "null"]},
          "content_digest": {"type": "string", "minLength": 1},
          "impacts": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "enforcement": {"enum": ["blocking", "advisory"]},
          "approval_evidence_id": {"type": ["string", "null"]}
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["updated", "not_applicable", "blocked"]},
        "reference": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]},
        "evidence_id": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  }
}
